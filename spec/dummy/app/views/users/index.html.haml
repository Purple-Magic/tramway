.flex.justify-between.mb-4.mt-4
  %h1{ class: "text-4xl font-bold text-left text-black-700 mb-8 mt-4" }
    = t('activerecord.plural.models.user.many')
= component 'tramway/table' do
  = component 'tramway/table/header', headers: [:email].map { |header| User.human_attribute_name header }
  = render @users

.flex.flex-col.items-center.border-t.border-gray-200.px-4.pt-4.w-full.gap-2
  = paginate @users
  %p.sm:hidden.text-xs.text-zinc-500
    = page_entries_info @users
