- current_filter = params[:filter]

.mt-4
  = tramway_table(class: 'mt-2 w-1/2') do
    - @filter_counts.each do |filter_name, count|
      - filter_params = request.query_parameters.except('page').merge(filter: filter_name)
      - badge_type = filter_name.to_s == current_filter ? :default : :secondary
      = tramway_row(href: public_send(custom_path_method, filter_params), cells: [[:name, tramway_badge(text: filter_name.to_s.upcase, type: badge_type)], [:count, count]])
