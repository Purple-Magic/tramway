- decorator = Tramway::Decorators::ClassHelper.decorator_class_name(@model_class, @namespace)
- index_attributes = decorator.constantize.index_attributes
- custom_path_method = "#{@model_class.model_name.plural}_path"
- custom_path_method = "#{@entity.namespace.gsub('/', '_')}_#{custom_path_method}" if @entity.namespace.present?

.md:mt-8.w-full
  - content_for :title, page_title

  .flex.justify-between.items-center
    = tramway_title do
      = content_for :title

    = component 'tramway/actions_buttons_container' do
      - if @entity.page(:create).present?
        = tramway_button text: t('tramway.actions.new'),
          path: Tramway::Engine.routes.url_helpers.public_send(@entity.routes.new),
          type: :will

  - if decorator.constantize.index_header_content.present?
    .mt-4
      = decorator.constantize.index_header_content.call(@entities)

  - filters_key = "#{@entity.namespace}-#{@entity.name}-index-filters" if @filter_counts.present?

  %div{ data: (@filter_counts.present? ? { controller: 'tramway--collapsible', key: filters_key } : {}) }
    .flex.flex-row.items-center.mt-2.gap-4{ class: (@filter_counts.present? ? 'justify-between' : 'justify-end') }
      - if @filter_counts.present?
        = tramway_button tag: :button, type: :secondary,
          options: { type: 'button', data: { action: 'tramway--collapsible#toggle', 'tramway--collapsible-target': 'toggle' } } do
          %i.fa.fa-filter.mr-1{ 'aria-hidden' => 'true' }
          = t('tramway.actions.filters')
          %i.fa.fa-chevron-down.ml-1.transition-transform.duration-200.ease-out-strong.motion-reduce:duration-0{ 'aria-hidden' => 'true', data: { 'tramway--collapsible-target': 'icon' } }

      .flex.flex-row.items-center.gap-4
        - if @entity.page(:index).search
          = form_with url: public_send(custom_path_method), method: :get, local: true, builder: Tramway::Form::Builder, horizontal: true do |f|
            = f.text_field :query, label: false, value: params[:query], placeholder: t('tramway.actions.search')
            = f.submit nil, 'aria-label' => t('tramway.actions.search') do
              %i.fa.fa-search{ 'aria-hidden' => 'true' }

        = paginate @entities, custom_path_method:

    - if @filter_counts.present?
      = render 'tramway/entities/filters', custom_path_method:

  - if index_attributes.empty?
    %p.text-center.mt-10
      You should fill class-level method `self.index_attributes` inside your
      = decorator
  - else
    = tramway_table class: 'mt-4' do
      = tramway_header headers: decorator.constantize.table_headers(entity: @entity)
      - @entities.each do |item|
        = component 'tramway/entity', entity: @entity, item: item

    .flex.flex-col.items-center.mt-4.gap-2
      = paginate @entities, custom_path_method:
      %p.sm:hidden.text-xs.text-zinc-500
        = page_entries_info @entities
