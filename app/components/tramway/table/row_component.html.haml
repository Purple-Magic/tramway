- if cells.any?
  = row_tag class: row_grid_classes, style: grid_template_style(cells.count), **options.except(:class, :style) do
    - cells.each do |(_, value)|
      %div.border-b.border-zinc-800{ class: cell_classes }
        = value

- else
  - cells = visible_cells_from(content)

  - if href.present?
    = tag.a href:, class: [row_grid_classes, link_row_classes, options[:class]].join(' '), style: grid_template_style(cells.count), **default_attributes, **options.except(:class, :style) do
      = content
  - else
    = tag.div class: [row_grid_classes, options[:class]].join(' '), style: grid_template_style(cells.count), **default_attributes, **options.except(:class, :style) do
      = content
