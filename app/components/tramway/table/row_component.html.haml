- if cells.any?
  = row_tag class: row_grid_classes(cells.count), **options do
    - cells.each do |(_, value)|
      %div.border-b.border-zinc-800{ class: cell_classes }
        = value

- else
  - cells = visible_cells_from(content)

  - if href.present?
    = tag.a href:, class: [row_grid_classes(cells.count), link_row_classes, options[:class]].join(' '), **default_attributes, **options.except(:class) do
      = content
  - else
    = tag.div class: [row_grid_classes(cells.count), options[:class]].join(' '), **default_attributes, **options.except(:class) do
      = content
