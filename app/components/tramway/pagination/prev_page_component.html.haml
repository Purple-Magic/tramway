- unless current_page.first?
  = link_to helpers.t('views.pagination.previous').html_safe,
    url,
    rel: 'prev',
    remote:,
    class: pagination_classes(klass: 'prev tramway-pagination__link--wide')

  = link_to '🠔',
    url,
    rel: 'prev',
    remote:,
    class: pagination_classes(klass: 'prev tramway-pagination__link--compact tramway-pagination__link--arrow')
