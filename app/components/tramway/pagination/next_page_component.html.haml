- unless current_page.last?
  = link_to helpers.t('views.pagination.next').html_safe,
    url,
    rel: 'next',
    remote:,
    class: pagination_classes(klass: 'next max-sm:hidden')

  = link_to '🠖',
    url,
    rel: 'next',
    remote:,
    class: pagination_classes(klass: 'next sm:hidden flex font-bold')
