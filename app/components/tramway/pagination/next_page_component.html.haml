- unless current_page.last?
  = link_to helpers.t('views.pagination.next').html_safe,
    url,
    rel: 'next',
    remote:,
    class: pagination_classes(klass: 'next tramway-pagination__link--wide')

  = link_to '🠖',
    url,
    rel: 'next',
    remote:,
    class: pagination_classes(klass: 'next tramway-pagination__link--compact tramway-pagination__link--arrow')
