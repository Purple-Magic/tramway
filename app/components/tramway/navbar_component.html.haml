- if horizontal?
  %nav#desktop-navbar.bg-zinc-950.text-zinc-50{ class: navbar_classes, data: { controller: 'tramway-navbar', direction: direction, expanded: 'true' } }
    .flex.md:justify-between.w-full.items-center.relative.min-h-8
      .block.sm:hidden
        %button#mobile-menu-button{ class: mobile_button_classes }
          ☰

      - if @left_items.present?
        %ul.hidden.md:flex.items-center.space-x-4
          - @left_items.each do |item|
            = item

      - if @title[:text].present?
        = content_tag :div, class: 'absolute left-1/2 transform -translate-x-1/2 md:left-1/2 md:-translate-x-1/2' do
          = link_to @title[:link] do
            .truncate{ class: title_classes }
              = @title[:text]

      - if @right_items.present?
        %ul.hidden.md:flex.items-center.space-x-4
          - @right_items.each do |item|
            = item

  #mobile-menu{ class: mobile_menu_classes }
    .flex.flex-1.flex-col
      .flex-1
        - if @left_items.present?
          %ul.flex.flex-col.space-y-1.pt-4
            - @left_items.each do |item|
              = item

        - if @right_items.present?
          %ul.flex.flex-col.space-y-1.pt-4
            - @right_items.each do |item|
              = item

      .pt-6
    %button.w-full.inline-flex.items-center.justify-center.rounded-md.border.border-zinc-700.bg-zinc-900.px-4.py-3.text-sm.font-semibold.text-zinc-50.transition-colors.hover:bg-zinc-800.hover:text-zinc-50.focus:outline-none.focus-visible:ring-2.focus-visible:ring-zinc-400.focus-visible:ring-offset-2.focus-visible:ring-offset-zinc-950#mobile-menu-close-button{ role: :button }
      Close
- else
  %nav#desktop-navbar{ class: navbar_classes, data: { controller: 'tramway-navbar', direction: direction, expanded: 'true' } }
    .relative{ class: mobile_horizontal_container_classes }
      .block.sm:hidden
        %button#mobile-menu-button{ class: mobile_button_classes }
          ☰

      - if @title[:text].present? || @left_items.present?
        .flex.items-center.absolute.transform{ class: 'left-1/2 -translate-x-1/2' }
          - if @title[:text].present?
            = link_to @title[:link] do
              .truncate{ class: title_classes }
                = @title[:text]
          - if @left_items.present?
            %ul.flex-row.items-center.space-x-4.ml-4.hidden.md:flex
              - @left_items.each do |item|
                = item

      - if @right_items.present?
        %ul.items-center.space-x-4.hidden.md:flex
          - @right_items.each do |item|
            = item

    .relative{ class: desktop_vertical_container_classes }
      - if @title[:text].present? || @left_items.present? || @right_items.present?
        #desktop-navbar-header{ class: desktop_vertical_header_classes }
          - if @title[:text].present?
            = link_to @title[:link] do
              .truncate{ class: title_classes }
                = @title[:text]

      - if @left_items.present? || @right_items.present?
        #desktop-navbar-content{ class: desktop_vertical_content_classes }
          - if @left_items.present?
            %ul{ class: desktop_vertical_item_list_classes }
              - @left_items.each do |item|
                = item

          - if @right_items.present?
            %ul{ class: desktop_vertical_item_list_classes }
              - @right_items.each do |item|
                = item

        .flex.w-full{ id: 'desktop-navbar-toggle-wrapper', class: desktop_vertical_toggle_wrapper_classes }
          %button#desktop-navbar-toggle-button{ class: desktop_vertical_toggle_button_classes, type: :button, aria: { controls: 'desktop-navbar', expanded: 'true', label: desktop_vertical_toggle_button_label(expanded: true) } }
            %i#desktop-navbar-toggle-icon{ class: desktop_vertical_toggle_icon_classes(expanded: true), aria: { hidden: true } }

    #mobile-menu{ class: mobile_menu_classes }
      .flex.flex-1.flex-col
        .flex-1
          - if @left_items.present?
            %ul.flex.flex-col.space-y-1.pt-4
              - @left_items.each do |item|
                = item

          - if @right_items.present?
            %ul.flex.flex-col.space-y-1.pt-4
              - @right_items.each do |item|
                = item

        .pt-6
      %button.w-full.inline-flex.items-center.justify-center.rounded-md.border.border-zinc-700.bg-zinc-900.px-4.py-3.text-sm.font-semibold.text-zinc-50.transition-colors.hover:bg-zinc-800.hover:text-zinc-50.focus:outline-none.focus-visible:ring-2.focus-visible:ring-zinc-400.focus-visible:ring-offset-2.focus-visible:ring-offset-zinc-950#mobile-menu-close-button{ role: :button }
        Close

  - if vertical?
    :javascript
      (function () {
        try {
          if (window.localStorage.getItem('tramway-navbar-expanded') === 'false') {
            document.documentElement.setAttribute('data-tramway-navbar-expanded', 'false');
          } else {
            document.documentElement.removeAttribute('data-tramway-navbar-expanded');
          }
        } catch (e) {}
      })();

    :css
      .tramway-navbar-desktop-vertical .tramway-navbar-item {
        width: 100%;
      }

      .tramway-navbar-desktop-vertical .tramway-navbar-item > a,
      .tramway-navbar-desktop-vertical .tramway-navbar-item > form {
        width: 100%;
      }

      .tramway-navbar-desktop-vertical .tramway-navbar-item > form {
        display: block;
      }

      .tramway-navbar-desktop-vertical .tramway-navbar-item > a,
      .tramway-navbar-desktop-vertical .tramway-navbar-item > form > button {
        width: 100%;
        justify-content: flex-start;
      }

      @media (min-width: 768px) {
        html[data-tramway-navbar-expanded="false"] #desktop-navbar {
          width: 6rem;
        }

        html[data-tramway-navbar-expanded="false"] #tramway-main-container {
          padding-left: 6rem;
        }

        html[data-tramway-navbar-expanded="false"] #desktop-navbar-header,
        html[data-tramway-navbar-expanded="false"] #desktop-navbar-content {
          opacity: 0;
          pointer-events: none;
        }

        html[data-tramway-navbar-expanded="false"] #desktop-navbar-toggle-wrapper {
          justify-content: flex-end;
        }

        html[data-tramway-navbar-expanded="false"] #desktop-navbar-toggle-icon {
          transform: rotate(180deg);
        }
      }
