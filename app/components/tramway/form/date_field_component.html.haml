%div{ class: default_container_classes }
  - if @label
    = component('tramway/form/label', for: @for, class: 'mb-0') do
      = @label
  - classes = text_input_classes
  = @input.call @attribute, **picker_options(classes), value: @value
  - if @hint.present?
    %p{ class: form_hint_classes }= @hint
