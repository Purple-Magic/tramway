%div{ class: container_classes, data: { controller: 'ui--checkbox' } }
  .tramway-form__check-row
    - checkbox_checked = checked?
    = @input.call @attribute, **hidden_checkbox_options
    %button{ type: 'button',
      role: 'checkbox',
      'aria-checked' => checkbox_checked.to_s,
      'data-action' => 'click->ui--checkbox#toggle',
      'data-state' => checkbox_checked ? 'checked' : 'unchecked',
      'data-ui--checkbox-target' => 'button',
      value: 'on',
      class: checkbox_button_classes,
      for: @for,
      id: @for }
      %span.tramway-form__check-indicator{ hidden: !checkbox_checked, data: { 'ui--checkbox-target' => 'indicator' } }
        %svg{ xmlns: 'http://www.w3.org/2000/svg',
          width: '24',
          height: '24',
          viewBox: '0 0 24 24',
          fill: 'none',
          stroke: 'currentColor',
          'stroke-width' => '3',
          'stroke-linecap' => 'round',
          'stroke-linejoin' => 'round',
          class: 'tramway-form__check-icon' }
          %polyline{ points: '20 6 9 17 4 12' }
    - if @label
      = component('tramway/form/label', for: @for, options: { class: label_classes, data: { action: 'click->ui--checkbox#toggle' } }) do
        = @label
  - if @hint.present?
    %p{ class: form_hint_classes }= @hint
