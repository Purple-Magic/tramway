%li.whitespace-nowrap
  - item_title = @options[:title] || strip_tags(content.to_s).squish.presence
  = link_to @href, class: style, **@options, title: item_title do
    - if icon?
      %i{ class: icon_classes, aria: { hidden: true } }
    %span.tramway-navbar-item-label.tramway-nav-item__label
      = content
